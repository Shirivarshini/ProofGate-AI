{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"https://proofgate.ai/schemas/audit/1.0", "title":"ProofGate Audit Event", "description":"Append-only audit record.", "type":"object", "additionalProperties":false,
